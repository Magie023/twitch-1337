# Ignore build artifacts
target/
**/target/

# Ignore git files
.git/
.gitignore

# Ignore local development files
*.swp
*.swo
*~
.DS_Store

# Ignore documentation (not needed in container)
*.md

# Ignore secrets and runtime state
# (patterns without **/ only match at the context root)
**/config.toml
**/*.ron
.env

# Ignore local/prod data mounts (just mount-prod-data, dev runs)
prod-data
dev-data
data

# Ignore agent/worktree clutter
.claude
.worktrees

# Ignore CI/CD files
.github/
