# Copy to .env (gitignored) for local `docker compose up`.
# On the dockhand server, set these as stack variables instead — mark
# CLOUDFLARE_TUNNEL_TOKEN as a secret so it is injected via shell env at
# deploy time and never written to disk.

# tracing/log filter for the bot. Default: info
RUST_LOG=info

# Cloudflare Tunnel token (secret). Required by the `tunnel` service.
CLOUDFLARE_TUNNEL_TOKEN=
